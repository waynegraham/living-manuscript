# All local by default. Never use NEXT_PUBLIC_ for keys or provider settings.
LLM_PROVIDER=lmstudio
STT_PROVIDER=mlx
TTS_PROVIDER=kokoro
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Copy the exact ID from GET /v1/models after loading Qwen3.
LM_STUDIO_MODEL=qwen3-8b
LM_STUDIO_API_KEY=
LOCAL_SPEECH_BASE_URL=http://127.0.0.1:8001
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
KOKORO_MODEL=mlx-community/Kokoro-82M-bf16
KOKORO_MANUSCRIPT_VOICE=af_heart
KOKORO_GUIDE_VOICE=am_adam
# Optional remote providers. No automatic cloud fallback.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_MANUSCRIPT_VOICE=shimmer
OPENAI_GUIDE_VOICE=onyx
